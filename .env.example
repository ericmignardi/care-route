# CareRoute — environment configuration
#
# Copy this file to `.env` and fill in the values:
#     cp .env.example .env
#
# `.env` is gitignored and must never be committed.

# ── Database ──────────────────────────────────────────────────────────────
# Consumed by docker-compose.yml and by backend/src/main/resources/application.properties
DATABASE_DB=careroute
DATABASE_USER=careroute
DATABASE_PASSWORD=careroute
DATABASE_PORT=5432

# ── JWT ───────────────────────────────────────────────────────────────────
# Signing key for HMAC-SHA256. MUST be at least 32 characters or the app will
# fail to start. Generate one with:
#     openssl rand -hex 32
# Never reuse the development key in production.
JWT_SECRET_KEY=replace-me-with-at-least-32-characters

# Token lifetime in milliseconds (86400000 = 24 hours)
JWT_EXPIRATION_TIME=86400000

# `Secure` flag on the auth cookie.
# false for local http://localhost, true in any deployed environment.
JWT_COOKIE_SECURE=false

# `SameSite` attribute on the auth cookie.
#   Lax  — local development, where frontend and backend share localhost
#   None — deployed, where the frontend (Static Web Apps) and backend
#          (Container Apps) sit on different domains, making every API call
#          cross-site. SameSite=None additionally REQUIRES Secure=true.
#
# Getting this wrong in production produces a login that appears to succeed
# followed by 401s on every subsequent request, with nothing useful logged.
JWT_COOKIE_SAME_SITE=Lax

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated list of origins permitted to call the API with credentials.
# Wildcards are not valid here — allowCredentials requires explicit origins.
# In production set this to the deployed frontend URL.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
